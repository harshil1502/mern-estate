# Tradovate credentials. Use the demo environment for paper trading.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=futures-bot
TRADOVATE_APP_VERSION=0.0.1
TRADOVATE_CID=
TRADOVATE_SECRET=

# "demo" or "live". Defaults to demo so a misconfigured run can't fire real orders.
TRADOVATE_ENV=demo

# Logging
LOG_LEVEL=INFO
